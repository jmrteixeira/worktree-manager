{
  "name": "worktree-manager",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n backend,frontend -c cyan,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "vite",
    "dev:server": "tsx watch server/index.ts",
    "desktop": "tauri",
    "desktop:dev": "tauri dev --config src-tauri/tauri.dev.conf.json",
    "desktop:build": "tauri build",
    "desktop:build:windows": "tauri build --config src-tauri/tauri.windows.conf.json --bundles nsis,msi",
    "desktop:info": "tauri info",
    "build": "tsc --noEmit && vite build",
    "build:desktop-ui": "tsc --noEmit && vite build --mode desktop",
    "desktop:check-production": "node scripts/check-desktop-production.mjs",
    "version:check": "node scripts/check-version.mjs",
    "release:checksums": "node scripts/checksums.mjs",
    "test": "vitest run",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/jest-dom": "^6.4.6",
    "@testing-library/react": "^15.0.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.4.20",
    "concurrently": "^8.2.2",
    "jsdom": "^24.1.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^8.1.2",
    "vitest": "^4.1.9"
  }
}
